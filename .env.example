# Copy to .env and export these variables in your shell.
# Never commit real provider URLs, API keys, private keys, or wallet secrets.
SOLANA_RPC_URL=https://your-archive-capable-solana-rpc
SOLANA_COMMITMENT=confirmed
SOLANA_RPC_TIMEOUT_MS=30000
SOLANA_NETWORK=mainnet

## Local-only capabilities. All are off unless explicitly set to exactly 1.
# Each capability also requires an independently confirmed private local genesis pin.
# Faucet is not enabled automatically by scripts/start-localnet.mjs.
COOK_LOCAL_RPC_URL=http://127.0.0.1:8899
COOK_LOCAL_GENESIS_HASH=
COOK_LOCAL_FAUCET=0
COOK_LOCAL_TRANSFER=0
COOK_LOCAL_TRADING=0

# Optional remote test validator: start scripts/start-localnet.mjs with exported values.
# Both addresses must use the same private IPv4 host; genesis must match.
COOK_REMOTE_RPC_URL=http://192.168.1.10:8899
COOK_REMOTE_WS_URL=ws://192.168.1.10:8900
COOK_PUMP_LAB_URL=http://192.168.1.10:3100

# COOK_LOCAL_TRANSFER=1 enables localnet wallet-to-wallet transfers only.
# COOK_LOCAL_TRADING=1 enables the local PumpSwap adapter only; keep off unless deliberately testing.
