{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dinnelthai/cook-system/blob/main/schemas/market-alert.schema.json",
  "title": "MarketAlert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "alert_id",
    "alert_type",
    "severity",
    "market",
    "window_start_ms",
    "window_end_ms",
    "observed_facts",
    "inferred_relationships",
    "evidence",
    "counter_evidence",
    "unknowns",
    "confidence",
    "data_completeness",
    "source_event_ids",
    "model_version",
    "explanation",
    "defensive_interpretation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "alert_id": { "type": "string", "minLength": 1 },
    "alert_type": {
      "type": "string",
      "enum": [
        "POSSIBLE_CONTROL_CLUSTER",
        "CIRCULAR_FLOW_SIGNATURE",
        "LOW_BREADTH_PRICE_SHOCK",
        "WEAK_BREADTH_RECOVERY",
        "EARLY_COHORT_INVENTORY_DECLINE",
        "TRANSFER_VS_SELL_MISMATCH",
        "GROSS_NET_DEMAND_DIVERGENCE",
        "ATTRIBUTION_UNCERTAINTY",
        "CURVE_STATE_OR_DATA_MISMATCH",
        "EXECUTION_ORDERING_DISTORTION"
      ]
    },
    "severity": { "type": "string", "enum": ["info", "low", "medium", "high"] },
    "market": { "$ref": "market-identity.schema.json" },
    "window_start_ms": { "type": "integer", "minimum": 0 },
    "window_end_ms": { "type": "integer", "minimum": 0 },
    "observed_facts": { "type": "array", "items": { "type": "string" } },
    "inferred_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "object", "relationship", "confidence"],
        "properties": {
          "subject": { "type": "string" },
          "object": { "type": "string" },
          "relationship": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "counter_evidence": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "data_completeness": {
      "type": "string",
      "enum": ["complete", "partial", "stale", "unknown"]
    },
    "source_event_ids": { "type": "array", "items": { "type": "string" } },
    "model_version": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": ["string", "null"] },
    "explanation": { "type": "string", "minLength": 1 },
    "defensive_interpretation": { "type": "string", "minLength": 1 }
  }
}