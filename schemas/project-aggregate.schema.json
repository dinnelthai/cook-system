{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dinnelthai/cook-system/blob/main/schemas/project-aggregate.schema.json",
  "title": "ProjectAggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "created_at_ms",
    "updated_at_ms",
    "profile",
    "network",
    "token",
    "wallet_groups",
    "markets",
    "limits",
    "lifecycle",
    "execution_policy",
    "source_attestation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "symbol",
        "description",
        "website",
        "telegram",
        "twitter"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9]{1,10}$"
        },
        "description": {
          "type": "string"
        },
        "website": {
          "type": [
            "string",
            "null"
          ]
        },
        "telegram": {
          "type": [
            "string",
            "null"
          ]
        },
        "twitter": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "cluster",
        "genesis_hash",
        "quote_mint"
      ],
      "properties": {
        "chain_id": {
          "const": "solana"
        },
        "cluster": {
          "type": "string",
          "enum": [
            "localnet",
            "devnet",
            "mainnet"
          ]
        },
        "genesis_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote_mint": {
          "type": "string",
          "const": "So11111111111111111111111111111111111111112"
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mint",
        "supply_base_units",
        "decimals",
        "creator_wallet_address",
        "issuance_status",
        "issuance_signature",
        "verification_evidence_ref"
      ],
      "properties": {
        "mint": {
          "type": [
            "string",
            "null"
          ]
        },
        "supply_base_units": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "decimals": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9
        },
        "creator_wallet_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "issuance_status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "EVIDENCE_UNVERIFIED",
            "VERIFIED"
          ]
        },
        "issuance_signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "wallet_groups": {
      "type": "array",
      "items": {
        "$ref": "project-wallet-group.schema.json"
      }
    },
    "markets": {
      "type": "array",
      "items": {
        "$ref": "project-market-binding.schema.json"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_project_budget_base_units",
        "max_order_size_base_units",
        "max_wallet_exposure_base_units",
        "max_drawdown_bps"
      ],
      "properties": {
        "max_project_budget_base_units": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_order_size_base_units": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_wallet_exposure_base_units": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_drawdown_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "operational_status",
        "stage_changed_at_ms",
        "evidence_ref"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "DRAFT",
            "READY",
            "LAUNCH_SUBMITTED",
            "LAUNCHED",
            "BONDING_CURVE_ACTIVE",
            "GRADUATION_PENDING",
            "PUMPSWAP_ACTIVE",
            "EXIT_IN_PROGRESS",
            "SETTLEMENT_PENDING",
            "CLOSED",
            "ARCHIVED"
          ]
        },
        "operational_status": {
          "type": "string",
          "enum": [
            "HALTED",
            "ACTIVE",
            "REVIEW_REQUIRED"
          ]
        },
        "stage_changed_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "enabled",
        "requires_risk_approval",
        "unknown_blocks_execution"
      ],
      "properties": {
        "mode": {
          "const": "DISABLED"
        },
        "enabled": {
          "const": false
        },
        "requires_risk_approval": {
          "const": true
        },
        "unknown_blocks_execution": {
          "const": true
        }
      }
    },
    "source_attestation": {
      "const": "UNKNOWN"
    }
  }
}
